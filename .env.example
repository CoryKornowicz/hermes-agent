# ── Required: at least one LLM provider key ─────────────────────────────────

# Recommended: OpenRouter (access to all models via one key)
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# Or: direct OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Or: direct Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# ── Optional: Tool APIs ──────────────────────────────────────────────────────

# Web search (pick one or more)
EXA_API_KEY=
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=

# Image generation
FAL_KEY=

# Cross-session user modeling
HONCHO_API_KEY=

# GitHub (higher rate limits for code tools)
GITHUB_TOKEN=

# ── Optional: Browser automation ─────────────────────────────────────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── Optional: iMessage ───────────────────────────────────────────────────────
# Normally set for you by the admin dashboard — listed here for reference.

# Photon (recommended: managed iMessage line, no Mac, no inbound webhook).
# "Connect Photon" in the dashboard provisions these via device login.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Comma-separated E.164, e.g. +15551234567
PHOTON_ALLOWED_USERS=
# Default target for scheduled messages
PHOTON_HOME_CHANNEL=

# BlueBubbles (bridge your own always-on Mac). The dashboard registers the
# public /bluebubbles-webhook relay with your server on save.
BLUEBUBBLES_SERVER_URL=
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_ALLOWED_USERS=
# Only needed when a proxy in front of this app rewrites the Host header.
BLUEBUBBLES_PUBLIC_URL=

# ── Gateway security ──────────────────────────────────────────────────────────
# Set to false and configure allowlists if you want to restrict access
GATEWAY_ALLOW_ALL_USERS=true

# ── Terminal backend ──────────────────────────────────────────────────────────
# Options: local, docker, modal, ssh
TERMINAL_ENV=local
TERMINAL_TIMEOUT=60
